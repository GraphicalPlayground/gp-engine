  "tasks": {
    "version": "2.0.0",
    "inputs": [
      {
        "id": "x64Path",
        "type": "promptString",
        "description": "Enter the path to the x64 Visual Studio tools",
        "default": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat",
      },
      {
        "id": "winPreset",
        "type": "pickString",
        "description": "Which Windows preset do you want to build?",
        "options": [
          "windows-release",
          "windows-debug",
          "windows-profile",
          "windows-development",
          "windows-asan"
        ],
        "default": "windows-development"
      },
      {
        "id": "linuxPreset",
        "type": "pickString",
        "description": "Which Linux preset do you want to build?",
        "options": [
          "linux-release",
          "linux-debug",
          "linux-profile",
          "linux-development",
          "linux-asan",
          "linux-ubsan",
          "linux-tsan",
          "linux-msan"
        ],
        "default": "linux-development"
      },
      {
        "id": "macPreset",
        "type": "pickString",
        "description": "Which macOS preset do you want to build?",
        "options": [
          "macos-release",
          "macos-debug",
          "macos-profile",
          "macos-development",
          "macos-asan",
          "macos-ubsan",
          "macos-tsan"
        ],
        "default": "macos-development"
      }
    ],
    "tasks": [
      {
        "label": "CMake: Configure",
        "type": "shell",
        "windows": {
          "command": "cmake --preset windows-development",
          "options": {
            "shell": {
              "executable": "cmd.exe",
              "args": [
                "/c",
                "call \"${input:x64Path}\" &&"
              ]
            }
          }
        },
        "linux": {
          "command": "cmake --preset linux-development"
        },
        "osx": {
          "command": "cmake --preset macos-development"
        },
        "detail": "Generates the CMake project using the default preset"
      },
      {
        "label": "CMake: Build",
        "type": "shell",
        "dependsOn": "CMake: Configure",
        "windows": {
          "command": "cmake --build --preset windows-development",
          "options": {
            "shell": {
              "executable": "cmd.exe",
              "args": [
                "/c",
                "call \"${input:x64Path}\" &&"
              ]
            }
          }
        },
        "linux": {
          "command": "cmake --build --preset linux-development"
        },
        "osx": {
          "command": "cmake --build --preset macos-development"
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [
          "$msCompile"
        ],
        "detail": "Builds the CMake project using the default preset"
      },
      {
        "label": "CMake: Build (Interactive)",
        "type": "shell",
        "windows": {
          "command": "cmake --build --preset ${input:winPreset}",
          "options": {
            "shell": {
              "executable": "cmd.exe",
              "args": [
                "/c",
                "call \"${input:x64Path}\" &&"
              ]
            }
          }
        },
        "linux": {
          "command": "cmake --build --preset ${input:linuxPreset}"
        },
        "osx": {
          "command": "cmake --build --preset ${input:macPreset}"
        },
        "group": "build",
        "problemMatcher": [
          "$msCompile"
        ],
        "detail": "Builds the CMake project using the platform-specific preset"
      },
      {
        "label": "CMake: Configure (Interactive)",
        "type": "shell",
        "windows": {
          "command": "cmake --preset ${input:winPreset}",
          "options": {
            "shell": {
              "executable": "cmd.exe",
              "args": [
                "/c",
                "call \"${input:x64Path}\" &&"
              ]
            }
          }
        },
        "linux": {
          "command": "cmake --preset ${input:linuxPreset}"
        },
        "osx": {
          "command": "cmake --preset ${input:macPreset}"
        },
        "group": "build",
        "problemMatcher": [
          "$msCompile"
        ],
        "detail": "Builds the CMake project using the platform-specific preset"
      }
    ]
  }
