<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0" xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">

  <assemblyIdentity
    version="1.0.0.0"
    processorArchitecture="amd64"
    name="GraphicalPlayground.Editor.Runtime"
    type="win32"
  />
  <description>Graphical Playground Editor Runtime Executable</description>

  <!-- UAC / PRIVILEGE LEVEL -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges>
        <!-- Games should never require Admin rights to run, only to install -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <!-- OS COMPATIBILITY (Prevents Windows from applying slow legacy shims) -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
      <!-- Windows 8.1 (Usually dropped for modern DirectX 12 / Vulkan engines, but included for fallback) -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}" />
    </application>
  </compatibility>

  <!-- MODERN WINDOWS FEATURES (DPI, Long Paths, UTF-8) -->
  <asmv3:application>
    <asmv3:windowsSettings>

      <!-- High DPI Awareness: Prevents Windows from blurring/scaling the window on 4K monitors -->
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2, PerMonitor</dpiAwareness>

      <!-- Long Path Awareness: Bypasses the 260-character MAX_PATH limit for deep asset folder trees -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>

      <!-- UTF-8 Code Page: Forces standard Windows string APIs to use UTF-8 instead of regional locales -->
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>

      <!-- Segment Heap: Opts into the modern, lower-fragmentation Windows heap allocator -->
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>

    </asmv3:windowsSettings>
  </asmv3:application>

</assembly>
